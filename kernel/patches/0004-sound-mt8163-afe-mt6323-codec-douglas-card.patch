--- a/sound/soc/mediatek/mt8163/mt8163-dai-adda.c
+++ b/sound/soc/mediatek/mt8163/mt8163-dai-adda.c
@@ -0,0 +1,207 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MT8163 AFE ADDA (internal DAC/ADC link to the MT6323 PMIC codec) back-end DAI.
+ *
+ * Playback: on MT8163 the internal DAC is fed through the "I2S1"/DAC I2S block
+ * (AFE_I2S_CON1, interconnect outputs O03/O04) plus the ADDA DL SRC2.
+ * Capture: the internal ADC arrives on interconnect inputs I03/I04 (shared with the
+ * external I2S2 input) through the ADDA UL SRC.
+ * Sequences follow MediaTek's GPL mt_soc_afe_control.c (SetI2SDacOut, SetDLSrc2,
+ * SetI2SDacEnable, SetI2SAdcIn, SetI2SAdcEnable) from Amazon's douglas 3.18 kernel.
+ */
+#include <linux/bitfield.h>
+#include <linux/regmap.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+
+#include "mt8163-afe-common.h"
+#include "mt8163-afe-regs.h"
+
+#define I2S_CON1_EN		BIT(0)
+#define I2S_CON1_WLEN_32BIT	BIT(1)
+#define I2S_CON1_FMT_I2S	BIT(3)
+#define I2S_CON1_RATE		GENMASK(11, 8)
+#define DL_SRC2_ON		BIT(0)
+#define ADDA_ON			BIT(0)	/* AFE_ADDA_UL_DL_CON0: shared by UL and DL */
+#define UL_SRC_ON		BIT(0)
+#define UL_VOICE_MODE		GENMASK(20, 17)
+#define UL_IIR_ON		BIT(10)		/* UL SRC IIR: DC-blocking high-pass */
+#define UL_IIR_MODE		GENMASK(9, 7)
+#define ADDA_TOP_EXT_ADC	BIT(0)
+#define O03_O04_24BIT		GENMASK(4, 3)
+
+static bool adda_dl_on, adda_ul_on;
+
+static int adda_dl_src2_rate(unsigned int rate)
+{
+	switch (rate) {
+	case 8000: return 0;
+	case 11025: return 1;
+	case 12000: return 2;
+	case 16000: return 3;
+	case 22050: return 4;
+	case 24000: return 5;
+	case 32000: return 6;
+	case 44100: return 7;
+	case 48000: return 8;
+	default: return -EINVAL;
+	}
+}
+
+static int adda_ul_voice_mode(unsigned int rate)
+{
+	switch (rate) {
+	case 8000: return 0;
+	case 16000: return 1;
+	case 32000: return 2;
+	case 48000: return 3;
+	default: return -EINVAL;
+	}
+}
+
+static int mt8163_adda_hw_params(struct snd_pcm_substream *substream,
+				 struct snd_pcm_hw_params *params,
+				 struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	unsigned int rate = params_rate(params);
+
+	if (substream->stream == SNDRV_PCM_STREAM_CAPTURE) {
+		int vm = adda_ul_voice_mode(rate);
+
+		if (vm < 0)
+			return -EINVAL;
+		/* SetI2SAdcIn(): internal ADC, UL SRC voice mode, up8x txif */
+		regmap_update_bits(afe->regmap, AFE_ADDA_TOP_CON0, ADDA_TOP_EXT_ADC, 0);
+		regmap_update_bits(afe->regmap, AFE_ADDA_UL_SRC_CON0,
+				   UL_VOICE_MODE | UL_IIR_ON | UL_IIR_MODE,
+				   vm << 19 | vm << 17 | UL_IIR_ON);
+		regmap_write(afe->regmap, AFE_ADDA_NEWIF_CFG0, 0x03f87201);
+		regmap_update_bits(afe->regmap, AFE_ADDA_NEWIF_CFG1, GENMASK(11, 10),
+				   (vm < 3 ? 1 : 3) << 10);
+		return 0;
+	} else {
+		int src2 = adda_dl_src2_rate(rate);
+		int fs = mt8163_general_rate_transform(rate);
+		bool wide = params_width(params) > 16;
+		u32 con0;
+
+		if (src2 < 0 || fs < 0)
+			return -EINVAL;
+
+		/* CleanPreDistortion() */
+		regmap_write(afe->regmap, AFE_ADDA_PREDIS_CON0, 0);
+		regmap_write(afe->regmap, AFE_ADDA_PREDIS_CON1, 0);
+
+		/* SetDLSrc2(): rate, gain path, -0.3 dB; 8k/16k use voice mode */
+		con0 = src2 << 28 | 0x03 << 24 | 0x03 << 11 | BIT(1);
+		if (src2 == 0 || src2 == 3)
+			con0 |= BIT(5);
+		regmap_write(afe->regmap, AFE_ADDA_DL_SRC2_CON0, con0);
+		regmap_write(afe->regmap, AFE_ADDA_DL_SRC2_CON1, 0xf74f0000);
+
+		/* SetI2SDacOut(): DAC I2S, no LR swap/LRCK invert, I2S format */
+		regmap_write(afe->regmap, AFE_I2S_CON1,
+			     FIELD_PREP(I2S_CON1_RATE, fs) | I2S_CON1_FMT_I2S |
+			     (wide ? I2S_CON1_WLEN_32BIT : 0));
+
+		/* Output data width of interconnect O03/O04 */
+		regmap_update_bits(afe->regmap, AFE_CONN_24BIT, O03_O04_24BIT,
+				   wide ? O03_O04_24BIT : 0);
+		return 0;
+	}
+}
+
+static int mt8163_adda_trigger(struct snd_pcm_substream *substream, int cmd,
+			       struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	bool capture = substream->stream == SNDRV_PCM_STREAM_CAPTURE;
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+		if (capture) {
+			/* SetI2SAdcEnable(true) */
+			regmap_update_bits(afe->regmap, AFE_ADDA_UL_SRC_CON0, UL_SRC_ON, UL_SRC_ON);
+			adda_ul_on = true;
+		} else {
+			/* SetI2SDacEnable(true) */
+			regmap_update_bits(afe->regmap, AFE_ADDA_DL_SRC2_CON0, DL_SRC2_ON, DL_SRC2_ON);
+			regmap_update_bits(afe->regmap, AFE_I2S_CON1, I2S_CON1_EN, I2S_CON1_EN);
+			adda_dl_on = true;
+		}
+		regmap_update_bits(afe->regmap, AFE_ADDA_UL_DL_CON0, ADDA_ON, ADDA_ON);
+		return 0;
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+		if (capture) {
+			regmap_update_bits(afe->regmap, AFE_ADDA_UL_SRC_CON0, UL_SRC_ON, 0);
+			adda_ul_on = false;
+		} else {
+			regmap_update_bits(afe->regmap, AFE_ADDA_DL_SRC2_CON0, DL_SRC2_ON, 0);
+			regmap_update_bits(afe->regmap, AFE_I2S_CON1, I2S_CON1_EN, 0);
+			adda_dl_on = false;
+		}
+		if (!adda_ul_on && !adda_dl_on)
+			regmap_update_bits(afe->regmap, AFE_ADDA_UL_DL_CON0, ADDA_ON, 0);
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static const struct snd_soc_dai_ops mt8163_adda_ops = {
+	.hw_params = mt8163_adda_hw_params,
+	.trigger = mt8163_adda_trigger,
+};
+
+static struct snd_soc_dai_driver mt8163_adda_dai_driver[] = {
+	{
+		.name = "ADDA",
+		.id = MT8163_AFE_DAI_ADDA,
+		.playback = {
+			.stream_name = "ADDA Playback",
+			.channels_min = 1,
+			.channels_max = 2,
+			.rates = SNDRV_PCM_RATE_8000_48000,
+			.formats = SNDRV_PCM_FMTBIT_S16_LE | SNDRV_PCM_FMTBIT_S24_LE |
+				   SNDRV_PCM_FMTBIT_S32_LE,
+		},
+		.capture = {
+			.stream_name = "ADDA Capture",
+			.channels_min = 1,
+			.channels_max = 2,
+			.rates = SNDRV_PCM_RATE_8000 | SNDRV_PCM_RATE_16000 |
+				 SNDRV_PCM_RATE_32000 | SNDRV_PCM_RATE_48000,
+			.formats = SNDRV_PCM_FMTBIT_S16_LE | SNDRV_PCM_FMTBIT_S24_LE |
+				   SNDRV_PCM_FMTBIT_S32_LE,
+		},
+		.ops = &mt8163_adda_ops,
+	},
+};
+
+static const struct snd_soc_dapm_route mt8163_adda_routes[] = {
+	/* The DAC I2S reuses the I2S1 interconnect mixers (DL1/DL2 -> O03/O04). */
+	{ "ADDA Playback", NULL, "I2S1_CH1" },
+	{ "ADDA Playback", NULL, "I2S1_CH2" },
+	/* Internal ADC -> I03/I04 -> VUL (O09/O10); the mixer inputs are named I2S2_CHx. */
+	{ "VUL_CH1", "I2S2_CH1", "ADDA Capture" },
+	{ "VUL_CH2", "I2S2_CH2", "ADDA Capture" },
+};
+
+int mt8163_dai_adda_register(struct mtk_base_afe *afe)
+{
+	struct mtk_base_afe_dai *dai;
+
+	dai = devm_kzalloc(afe->dev, sizeof(*dai), GFP_KERNEL);
+	if (!dai)
+		return -ENOMEM;
+
+	list_add(&dai->list, &afe->sub_dais);
+	dai->dai_drivers = mt8163_adda_dai_driver;
+	dai->num_dai_drivers = ARRAY_SIZE(mt8163_adda_dai_driver);
+	dai->dapm_routes = mt8163_adda_routes;
+	dai->num_dapm_routes = ARRAY_SIZE(mt8163_adda_routes);
+	return 0;
+}
