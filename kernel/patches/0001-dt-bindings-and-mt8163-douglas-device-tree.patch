--- a/arch/arm64/boot/dts/mediatek/douglas-perf.dtsi
+++ b/arch/arm64/boot/dts/mediatek/douglas-perf.dtsi
@@ -0,0 +1,29 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Amazon Fire HD 8 (douglas): performance - CPU DVFS up to 1.3 GHz with thermal protection.
+ *
+ * The SoC thermal controller has the same layout as MT2701 for bank 0 (TS_MCU1 = mux 0,
+ * TS_MCU2 = mux 1, plus TS_ABB = mux 0x10, AUXADC channel 11) per Amazon's mt8163
+ * mtk_thermal.c, and its efuse calibration words live at 0x10206180..0x1020618b.
+ */
+
+&auxadc {
+	status = "okay";
+};
+
+&thermal_calibration {
+	reg = <0x180 0xc>;
+};
+
+&thermal {
+	compatible = "mediatek,mt8163-thermal", "mediatek,mt2701-thermal";
+};
+
+&cpu_crit {
+	temperature = <105000>;
+};
+
+/* VSEL pin state is unknown to Linux: keep both voltage registers identical */
+&sym827_vproc {
+	douglas,mirror-vsel;
+};
--- a/arch/arm64/boot/dts/mediatek/douglas-power.dtsi
+++ b/arch/arm64/boot/dts/mediatek/douglas-power.dtsi
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+// Fire HD 8 (2017, douglas) power: TI bq24297 charger, MT6323 BATSNS battery
+// gauge using the stock bat_meter 25C OCV profile, and keypad volume-up.
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/iio/adc/mediatek,mt6323-auxadc.h>
+
+/ {
+	bat: battery {
+		compatible = "simple-battery";
+		device-chemistry = "lithium-ion-polymer";
+		charge-full-design-microamp-hours = <4750000>;
+		voltage-min-design-microvolt = <3400000>;
+		voltage-max-design-microvolt = <4200000>;
+		constant-charge-voltage-max-microvolt = <4208000>;
+		ocv-capacity-celsius = <25>;
+		ocv-capacity-table-0 = <4177000 100 4157000 99 4139000 98 4127000 97 4115000 96 4104000 95>,
+			<4094000 93 4084000 92 4076000 91 4071000 90 4067000 89 4060000 88>,
+			<4047000 87 4027000 86 4009000 85 3995000 84 3985000 82 3978000 81>,
+			<3971000 80 3967000 79 3965000 78 3963000 77 3958000 76 3951000 75>,
+			<3944000 74 3938000 73 3932000 71 3925000 70 3919000 69 3913000 68>,
+			<3908000 67 3902000 66 3896000 65 3891000 64 3885000 63 3880000 62>,
+			<3873000 61 3866000 59 3857000 58 3845000 57 3835000 56 3827000 55>,
+			<3821000 54 3816000 53 3812000 52 3808000 51 3805000 50 3801000 48>,
+			<3798000 47 3793000 45 3788000 43 3783000 41 3779000 39 3776000 36>,
+			<3774000 34 3772000 32 3770000 30 3767000 28 3764000 27 3761000 25>,
+			<3759000 24 3755000 23 3751000 22 3746000 21 3739000 19 3735000 18>,
+			<3729000 17 3722000 16 3716000 14 3710000 13 3702000 12 3693000 11>,
+			<3690000 10 3687000 8 3684000 6 3680000 5 3657000 3 3609000 2>,
+			<3544000 1 3450000 0>;
+	};
+
+	adc-battery {
+		compatible = "adc-battery";
+		io-channels = <&pmic_adc MT6323_AUXADC_BATSNS>;
+		io-channel-names = "voltage";
+		monitored-battery = <&bat>;
+		power-supplies = <&charger>;
+	};
+};
+
+&pmic {
+	pmic_adc: adc {
+		compatible = "mediatek,mt6323-auxadc";
+		#io-channel-cells = <1>;
+	};
+};
+
+&i2c2 {
+	clock-frequency = <100000>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&douglas_i2c2_pins>;
+	status = "okay";
+
+	charger: charger@6b {
+		compatible = "ti,bq24297";
+		reg = <0x6b>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&douglas_charger_pins>;
+		interrupt-parent = <&pio>;
+		interrupts = <1 IRQ_TYPE_EDGE_FALLING>;
+		monitored-battery = <&bat>;
+		omit-battery-class;
+	};
+};
+
+&keypad {
+	keypad,num-rows = <8>;
+	keypad,num-columns = <9>;
+	debounce-delay-ms = <32>;
+	linux,keymap = <MATRIX_KEY(0, 0, KEY_VOLUMEUP)>;
+	status = "okay";
+};
+
+&pio {
+	douglas_i2c2_pins: douglas-i2c2-pins {
+		pins {
+			pinmux = <MT8163_PIN_77_SDA2__FUNC_SDA2_0>,
+				 <MT8163_PIN_78_SCL2__FUNC_SCL2_0>;
+			bias-disable;
+		};
+	};
+	douglas_charger_pins: douglas-charger-pins {
+		pins-int {
+			pinmux = <MT8163_PIN_23_EINT1__FUNC_GPIO23>;
+			bias-pull-up;
+			input-enable;
+		};
+		pins-chg-en {
+			/* bq24297 CE is active low: keep charging enabled. */
+			pinmux = <MT8163_PIN_22_EINT0__FUNC_GPIO22>;
+			output-low;
+		};
+	};
+};
--- a/arch/arm64/boot/dts/mediatek/douglas-sd-sensors.dtsi
+++ b/arch/arm64/boot/dts/mediatek/douglas-sd-sensors.dtsi
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Amazon Fire HD 8 (douglas): microSD slot (MSDC1) and the BMA253 accelerometer.
+ * Values from Amazon's douglas.dts (Fire OS kernel 3.18).
+ */
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/pinctrl/mt65xx.h>
+
+/*
+ * Keep the eMMC as mmcblk0 (the initramfs and tools look for mmcblk0p*); without aliases
+ * the microSD host probes first and takes index 0.
+ */
+/ {
+	aliases {
+		mmc0 = &mmc0;
+		mmc1 = &mmc1;
+	};
+};
+
+&pio {
+	douglas_mmc1_pins: douglas-mmc1-pins {
+		pins-cmd-dat {
+			pinmux = <MT8163_PIN_123_MSDC1_DAT0__FUNC_MSDC1_DAT0>,
+				 <MT8163_PIN_124_MSDC1_DAT1__FUNC_MSDC1_DAT1>,
+				 <MT8163_PIN_125_MSDC1_DAT2__FUNC_MSDC1_DAT2>,
+				 <MT8163_PIN_126_MSDC1_DAT3__FUNC_MSDC1_DAT3>,
+				 <MT8163_PIN_121_MSDC1_CMD__FUNC_MSDC1_CMD>;
+			input-enable;
+			drive-strength = <MTK_DRIVE_6mA>;
+			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
+		};
+		pins-clk {
+			pinmux = <MT8163_PIN_122_MSDC1_CLK__FUNC_MSDC1_CLK>;
+			drive-strength = <MTK_DRIVE_6mA>;
+			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
+		};
+		pins-insert {
+			pinmux = <MT8163_PIN_49_EINT17__FUNC_GPIO49>;
+			bias-pull-up;
+		};
+	};
+};
+
+/* microSD: high-speed only for now (no UHS voltage switching) */
+&mmc1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&douglas_mmc1_pins>;
+	bus-width = <4>;
+	max-frequency = <50000000>;
+	cap-sd-highspeed;
+	cd-gpios = <&pio 49 GPIO_ACTIVE_LOW>;
+	vmmc-supply = <&mt6323_vmch_reg>;
+	vqmmc-supply = <&mt6323_vmc_reg>;
+	no-sdio;
+	no-mmc;
+	status = "okay";
+};
+
+&i2c2 {
+	/*
+	 * Fire OS "cust_gsensor": BMA253 at 0x18. Calibrated on the device against
+	 * iio-sensor-proxy/Phosh: raw X gives the right landscape direction, upright portrait
+	 * reads +1 g on raw Y and face-up -1 g on raw Z, so Y and Z are flipped
+	 * (a 180 degree rotation about X).
+	 */
+	accelerometer@18 {
+		compatible = "bosch,bma253";
+		reg = <0x18>;
+		mount-matrix = "1", "0", "0",
+			       "0", "-1", "0",
+			       "0", "0", "-1";
+	};
+};
--- a/arch/arm64/boot/dts/mediatek/douglas-smp.dtsi
+++ b/arch/arm64/boot/dts/mediatek/douglas-smp.dtsi
@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+// Bring up CPU1-3 through the stock vendor ATF's PSCI 0.1 interface.
+// Function IDs are copied from the stock Fire OS device tree (/psci node);
+// the vendor firmware predates PSCI 0.2's PSCI_VERSION discovery.
+
+&{/psci} {
+	compatible = "arm,psci";
+	method = "smc";
+	cpu_suspend = <0x84000001>;
+	cpu_off = <0x84000002>;
+	cpu_on = <0x84000003>;
+};
+
+&cpu0 { enable-method = "psci"; };
+&cpu1 { enable-method = "psci"; status = "okay"; };
+&cpu2 { enable-method = "psci"; status = "okay"; };
+&cpu3 { enable-method = "psci"; status = "okay"; };
--- a/arch/arm64/boot/dts/mediatek/douglas-wifi.dtsi
+++ b/arch/arm64/boot/dts/mediatek/douglas-wifi.dtsi
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+// Fire HD 8 (2017, douglas) MT6625L connectivity (CONSYS/WMT, BTIF, Wi-Fi) for the
+// ported MediaTek gen2 stack. Addresses/IRQs from the stock douglas device tree;
+// bindings follow frank-w's MT7623 port (same CONSYS family and MT6323 PMIC).
+
+/ {
+	reserved-memory {
+		consys-reserve-memory {
+			compatible = "mediatek,consys-reserve-memory";
+			no-map;
+			size = <0 0x100000>;
+			alignment = <0 0x100000>;
+		};
+	};
+};
+
+&{/soc} {
+	consys: consys@18070000 {
+		compatible = "mediatek,mt8163-consys";
+		reg = <0 0x18070000 0 0x200>,	/* CONN_MCU_CONFIG */
+		      <0 0x10001000 0 0x1000>;	/* INFRACFG (EMI remap at +0x320) */
+		interrupts = <GIC_SPI 237 IRQ_TYPE_LEVEL_LOW>,	/* BGF_EINT */
+			     <GIC_SPI 236 IRQ_TYPE_LEVEL_LOW>;	/* WDT_EINT */
+		power-domains = <&spm MT8163_POWER_DOMAIN_CONN>;
+		resets = <&watchdog MT8163_TOPRGU_CONN_MCU_RST>;
+		reset-names = "connsys";
+		mediatek,pwrap-regmap = <&pwrap>;
+		vcn18-supply = <&mt6323_vcn18_reg>;
+		vcn28-supply = <&mt6323_vcn28_reg>;
+		vcn33_bt-supply = <&mt6323_vcn33_bt_reg>;
+		vcn33_wifi-supply = <&mt6323_vcn33_wifi_reg>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&douglas_consys_pins>;
+	};
+
+	wifi@180f0000 {
+		compatible = "mediatek,mt8163-wifi", "mediatek,wifi";
+		reg = <0 0x180f0000 0 0x5c>;
+		interrupts = <GIC_SPI 238 IRQ_TYPE_LEVEL_LOW>;
+		clocks = <&infracfg CLK_INFRA_AP_DMA>;
+		clock-names = "wifi-dma";
+	};
+
+	btif: serial@1100c000 {
+		/* Not "mediatek,mtk-btif": mainline 8250_of would claim it as a plain UART. */
+		compatible = "mediatek,mt8163-btif-wmt";
+		reg = <0 0x1100c000 0 0x1000>;
+		interrupts = <GIC_SPI 112 IRQ_TYPE_LEVEL_LOW>;
+		clocks = <&infracfg CLK_INFRA_BTIF>, <&infracfg CLK_INFRA_AP_DMA>;
+		clock-names = "main", "apdmac";
+		reg-shift = <2>;
+		reg-io-width = <4>;
+	};
+
+	btif_tx@11000700 {
+		compatible = "mediatek,btif_tx";
+		reg = <0 0x11000700 0 0x80>;
+		interrupts = <GIC_SPI 110 IRQ_TYPE_LEVEL_LOW>;
+	};
+
+	btif_rx@11000780 {
+		compatible = "mediatek,btif_rx";
+		reg = <0 0x11000780 0 0x80>;
+		interrupts = <GIC_SPI 111 IRQ_TYPE_LEVEL_LOW>;
+	};
+};
+
+&pio {
+	douglas_consys_pins: douglas-consys-pins {
+		pins {
+			pinmux = <MT8163_PIN_60_WB_RSTB__FUNC_WB_RSTB>,
+				 <MT8163_PIN_63_WB_SCLK__FUNC_WB_SCLK>,
+				 <MT8163_PIN_64_WB_SDATA__FUNC_WB_SDATA>,
+				 <MT8163_PIN_65_WB_SEN__FUNC_WB_SEN>;
+			bias-pull-up;
+		};
+	};
+};
--- a/arch/arm64/boot/dts/mediatek/mt6323.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6323.dtsi
@@ -0,0 +1,247 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (c) 2017-2018 MediaTek Inc.
+ * Author: John Crispin <john@phrozen.org>
+ *	   Sean Wang <sean.wang@mediatek.com>
+ *
+ */
+
+&pwrap {
+	pmic: mt6323 {
+		compatible = "mediatek,mt6323";
+		interrupt-controller;
+		#interrupt-cells = <2>;
+
+		mt6323_leds: leds {
+			compatible = "mediatek,mt6323-led";
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "disabled";
+		};
+
+		mt6323regulator: mt6323regulator {
+			compatible = "mediatek,mt6323-regulator";
+
+			mt6323_vproc_reg: buck_vproc {
+				regulator-name = "vproc";
+				regulator-min-microvolt = < 700000>;
+				regulator-max-microvolt = <1350000>;
+				regulator-ramp-delay = <12500>;
+			};
+
+			mt6323_vsys_reg: buck_vsys {
+				regulator-name = "vsys";
+				regulator-min-microvolt = <1400000>;
+				regulator-max-microvolt = <2987500>;
+				regulator-ramp-delay = <25000>;
+			};
+
+			mt6323_vpa_reg: buck_vpa {
+				regulator-name = "vpa";
+				regulator-min-microvolt = < 500000>;
+				regulator-max-microvolt = <3650000>;
+			};
+
+			mt6323_vtcxo_reg: ldo_vtcxo {
+				regulator-name = "vtcxo";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+				regulator-enable-ramp-delay = <90>;
+			};
+
+			mt6323_vcn28_reg: ldo_vcn28 {
+				regulator-name = "vcn28";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+				regulator-enable-ramp-delay = <185>;
+			};
+
+			mt6323_vcn33_bt_reg: ldo_vcn33_bt {
+				regulator-name = "vcn33_bt";
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3600000>;
+				regulator-enable-ramp-delay = <185>;
+			};
+
+			mt6323_vcn33_wifi_reg: ldo_vcn33_wifi {
+				regulator-name = "vcn33_wifi";
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3600000>;
+				regulator-enable-ramp-delay = <185>;
+			};
