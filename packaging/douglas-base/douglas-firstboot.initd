#!/sbin/openrc-run
# One-time setup on the first boot of a freshly flashed Fire HD 8 Linux image:
# grow the root filesystem to fill the userdata partition, create a unique machine id,
# and copy this tablet's own Wi-Fi/Bluetooth firmware and calibration into place.

description="First-boot setup for Fire HD 8 Linux"
DONE=/var/lib/douglas/firstboot-done

depend() {
	need localmount
	before douglas-wifi networkmanager dbus tinydm
}

start() {
	[ -e $DONE ] && return 0
	ebegin "First-boot setup"

	root=$(findmnt -n -o SOURCE / 2>/dev/null || awk '$2 == "/" { print $1 }' /proc/mounts | tail -1)
	case "$root" in
	/dev/mmcblk*) resize2fs "$root" >/var/log/douglas-firstboot.log 2>&1 \
		&& einfo "root filesystem grown to fill $root" ;;
	esac

	if [ ! -s /etc/machine-id ]; then
		dbus-uuidgen > /etc/machine-id 2>/dev/null || \
			head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n' > /etc/machine-id
	fi

	/usr/bin/douglas-firmware extract >>/var/log/douglas-firstboot.log 2>&1

	mkdir -p /var/lib/douglas
	touch $DONE
	eend 0
}
