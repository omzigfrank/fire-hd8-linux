+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Amazon Fire HD 8 (2017, "douglas") sound card:
+ * MT8163 AFE DL1 -> ADDA -> MT6323 DAC/HP buffers -> external speaker amp
+ * (GPIO, "Speaker") or headphone jack amp (GPIO, "Headphone").
+ */
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <sound/soc.h>
+
+struct douglas_card {
+	struct gpio_desc *spk_en;
+	struct gpio_desc *hp_en;
+};
+
+static int douglas_spk_event(struct snd_soc_dapm_widget *w,
+			     struct snd_kcontrol *k, int event)
+{
+	struct douglas_card *priv = snd_soc_card_get_drvdata(snd_soc_dapm_to_card(w->dapm));
+
+	if (SND_SOC_DAPM_EVENT_ON(event)) {
+		gpiod_set_value_cansleep(priv->spk_en, 1);
+		msleep(25);	/* SPK_WARM_UP_TIME in the vendor driver */
+	} else {
+		gpiod_set_value_cansleep(priv->spk_en, 0);
+	}
+	return 0;
+}
+
+static int douglas_hp_event(struct snd_soc_dapm_widget *w,
+			    struct snd_kcontrol *k, int event)
+{
+	struct douglas_card *priv = snd_soc_card_get_drvdata(snd_soc_dapm_to_card(w->dapm));
+
+	gpiod_set_value_cansleep(priv->hp_en, SND_SOC_DAPM_EVENT_ON(event));
+	return 0;
+}
+
+static const struct snd_soc_dapm_widget douglas_widgets[] = {
+	SND_SOC_DAPM_SPK("Speaker", douglas_spk_event),
+	SND_SOC_DAPM_HP("Headphone", douglas_hp_event),
+	SND_SOC_DAPM_MIC("Internal Mic", NULL),
+};
+
+static const struct snd_soc_dapm_route douglas_routes[] = {
+	{ "Speaker", NULL, "HPL" },
+	{ "Speaker", NULL, "HPR" },
+	{ "Headphone", NULL, "HPL" },
+	{ "Headphone", NULL, "HPR" },
+	{ "MIC1", NULL, "Internal Mic" },
+};
+
+static const struct snd_kcontrol_new douglas_controls[] = {
+	SOC_DAPM_PIN_SWITCH("Speaker"),
+	SOC_DAPM_PIN_SWITCH("Headphone"),
+};
+
+SND_SOC_DAILINK_DEFS(playback,
+	DAILINK_COMP_ARRAY(COMP_CPU("DL1")),
+	DAILINK_COMP_ARRAY(COMP_DUMMY()),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+SND_SOC_DAILINK_DEFS(capture,
+	DAILINK_COMP_ARRAY(COMP_CPU("VUL")),
+	DAILINK_COMP_ARRAY(COMP_DUMMY()),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+SND_SOC_DAILINK_DEFS(adda,
+	DAILINK_COMP_ARRAY(COMP_CPU("ADDA")),
+	DAILINK_COMP_ARRAY(COMP_CODEC(NULL, "mt6323-codec-dai")),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+static int douglas_late_probe(struct snd_soc_card *card)
+{
+	struct snd_soc_dapm_context *dapm = snd_soc_card_to_dapm(card);
+
+	/* Speakers by default; userspace switches to "Headphone" when wanted. */
+	snd_soc_dapm_disable_pin(dapm, "Headphone");
+	snd_soc_dapm_enable_pin(dapm, "Speaker");
+	return snd_soc_dapm_sync(dapm);
+}
