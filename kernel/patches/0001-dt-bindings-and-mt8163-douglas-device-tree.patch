--- a/arch/arm64/boot/dts/mediatek/douglas-audio.dtsi
+++ b/arch/arm64/boot/dts/mediatek/douglas-audio.dtsi
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+// Fire HD 8 (2017, douglas) audio: MT8163 AFE (DL1 -> ADDA) -> MT6323 codec
+// -> headphone buffers -> external speaker amp (GPIO28) / headphone amp (GPIO44).
+// Pins and GPIOs from Amazon's douglas_hvt.dts (audgpio / aud_pins_*).
+
+/ {
+	sound {
+		compatible = "amazon,douglas-sound";
+		mediatek,platform = <&afe>;
+		mediatek,audio-codec = <&codec>;
+		speaker-amp-gpios = <&pio 28 GPIO_ACTIVE_HIGH>;
+		headphone-amp-gpios = <&pio 44 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&douglas_amp_pins>;
+	};
+};
+
+&codec {
+	compatible = "mediatek,mt6323-codec";
+};
+
+&afe {
+	pinctrl-names = "default";
+	pinctrl-0 = <&douglas_aud_pins>;
+	status = "okay";
+};
+
+&pio {
+	douglas_aud_pins: douglas-aud-pins {
+		pins {
+			pinmux = <MT8163_PIN_7_AUD_CLK_MOSI__FUNC_AUD_CLK_MOSI>,
+				 <MT8163_PIN_8_AUD_DAT_MISO__FUNC_AUD_DAT_MISO>,
+				 <MT8163_PIN_9_AUD_DAT_MOSI__FUNC_AUD_DAT_MOSI>;
+		};
+	};
+	douglas_amp_pins: douglas-amp-pins {
+		pins {
+			pinmux = <MT8163_PIN_28_EINT6__FUNC_GPIO28>,
+				 <MT8163_PIN_44_EINT12__FUNC_GPIO44>;
+			output-low;
+		};
+	};
+};
