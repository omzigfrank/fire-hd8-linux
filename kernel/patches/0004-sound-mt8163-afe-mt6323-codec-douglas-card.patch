+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek MT6323 PMIC audio codec: playback (DAC + headphone buffers) and
+ * capture (main analog microphone -> PGA -> ADC, "ACC" mode).
+ *
+ * Register sequences follow MediaTek's GPL mt_soc_codec_63xx.c as shipped in
+ * Amazon's Fire HD 8 (2017, "douglas") Linux 3.18 kernel. The analog
+ * headphone buffers also feed the board's external speaker amplifier, which
+ * the machine driver switches with a GPIO.
+ */
+#include <linux/delay.h>
+#include <linux/mfd/mt6397/core.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+#include <sound/tlv.h>
+
+/* PMIC registers (MT6323) */
+#define MT6323_TOP_CKPDN0_SET		0x0104
+#define MT6323_TOP_CKPDN0_CLR		0x0106
+#define MT6323_TOP_CKPDN1_SET		0x010a
+#define MT6323_TOP_CKPDN1_CLR		0x010c
+#define MT6323_AUDTOP_CON0		0x0700
+#define MT6323_AUDTOP_CON1		0x0702
+#define MT6323_AUDTOP_CON2		0x0704
+#define MT6323_AUDTOP_CON3		0x0706
+#define MT6323_AUDTOP_CON4		0x0708
+#define MT6323_AUDTOP_CON5		0x070a
+#define MT6323_AUDTOP_CON6		0x070c
+#define MT6323_AUDTOP_CON7		0x070e
+#define MT6323_AUDTOP_CON8		0x0710
+#define MT6323_ABB_AFE_CON0		0x4000
+#define MT6323_ABB_AFE_CON1		0x4002
+#define MT6323_ABB_AFE_CON3		0x4006
+#define MT6323_ABB_AFE_CON4		0x4008
+#define MT6323_ABB_AFE_CON10		0x4014
+#define MT6323_ABB_AFE_CON11		0x4016
+#define MT6323_AFE_PMIC_NEWIF_CFG0	0x4024
+#define MT6323_AFE_PMIC_NEWIF_CFG2	0x4028
+
+#define CLKSQ_EN_AUD			BIT(0)	/* TOP_CKPDN0: RG_CLKSQ_EN_AUD */
+#define AUD_26M_CK_PDN			BIT(8)	/* TOP_CKPDN1 */
+
+struct mt6323_codec {
+	struct device *dev;
+	struct regmap *regmap;
+	unsigned int rate;
+	unsigned int ul_rate;
+	unsigned int hp_gain;	/* 0..7 => -5 dB .. +9 dB in 2 dB steps */
+	unsigned int mic_gain;	/* 0..5 => -6 dB .. +24 dB in 6 dB steps */
+	int clk_users;		/* Topck_Enable() refcount shared by DAC and ADC */
+	bool dl_on, ul_on;
+};
+
+/* Topck_Enable(): audio clock square + 26 MHz clock, shared by the DL and UL paths */
+static void mt6323_clk(struct mt6323_codec *c, bool on)
+{
+	if (on) {
+		if (c->clk_users++ == 0) {
+			regmap_write(c->regmap, MT6323_TOP_CKPDN0_SET, CLKSQ_EN_AUD);
+			regmap_write(c->regmap, MT6323_TOP_CKPDN1_CLR, AUD_26M_CK_PDN);
+			udelay(250);
+		}
+	} else if (c->clk_users > 0 && --c->clk_users == 0) {
+		regmap_write(c->regmap, MT6323_TOP_CKPDN1_SET, AUD_26M_CK_PDN);
+		regmap_write(c->regmap, MT6323_TOP_CKPDN0_CLR, CLKSQ_EN_AUD);
+	}
+}
+
+static void mt6323_update(struct mt6323_codec *c, unsigned int reg,
+			  unsigned int mask, unsigned int val)
+{
+	regmap_update_bits(c->regmap, reg, mask, val);
+}
+
+static void mt6323_toggle(struct mt6323_codec *c, unsigned int status_bit,
+			  unsigned int trigger_bit)
+{
+	unsigned int v = 0;
+
+	regmap_read(c->regmap, MT6323_ABB_AFE_CON11, &v);
+	mt6323_update(c, MT6323_ABB_AFE_CON11, trigger_bit,
+		      (v & status_bit) ? 0 : trigger_bit);
+}
+
+static int mt6323_dl_newif_rate(unsigned int rate)
+{
+	switch (rate) {
+	case 8000: return 0;
+	case 11025: return 1;
+	case 12000: return 2;
+	case 16000: return 3;
+	case 22050: return 4;
+	case 24000: return 5;
+	case 32000: return 6;
+	case 44100: return 7;
+	case 48000: return 8;
+	default: return -EINVAL;
+	}
+}
+
+static int mt6323_dl_rate(unsigned int rate)
+{
+	switch (rate) {
+	case 8000: return 0;
+	case 11025: return 1;
+	case 12000: return 2;
+	case 16000: return 4;
+	case 22050: return 5;
+	case 24000: return 6;
+	case 32000: return 8;
+	case 44100: return 9;
+	case 48000: return 10;
+	default: return -EINVAL;
+	}
+}
+
+/* TurnOnDacPower / TurnOffDacPower */
+static int mt6323_dac_event(struct snd_soc_dapm_widget *w,
+			    struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *cmp = snd_soc_dapm_to_component(w->dapm);
+	struct mt6323_codec *c = snd_soc_component_get_drvdata(cmp);
+	int newif = mt6323_dl_newif_rate(c->rate);
+	int dl = mt6323_dl_rate(c->rate);
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		if (newif < 0 || dl < 0)
+			return -EINVAL;
+		mt6323_clk(c, true);
+		c->dl_on = true;
+		mt6323_update(c, MT6323_AFE_PMIC_NEWIF_CFG0, 0xffff, newif << 12 | 0x330);
+		mt6323_update(c, MT6323_ABB_AFE_CON1, 0x000f, dl);
+		mt6323_toggle(c, BIT(0), BIT(8));	/* TopCtlChangeTrigger */
+		mt6323_update(c, MT6323_ABB_AFE_CON0, BIT(0), BIT(0));
+		break;
+	case SND_SOC_DAPM_POST_PMD:
+		mt6323_update(c, MT6323_ABB_AFE_CON0, BIT(0), 0);
+		mt6323_toggle(c, BIT(0), BIT(8));
+		c->dl_on = false;
+		mt6323_clk(c, false);
+		break;
+	}
+	return 0;
+}
+
+static void mt6323_mic_gain_apply(struct mt6323_codec *c)
+{
+	/* SetMicPGAGain(): LCH PGA in AUDTOP_CON0[6:4], RCH PGA in AUDTOP_CON1[10:8] */
+	mt6323_update(c, MT6323_AUDTOP_CON0, 0x0070, c->mic_gain << 4);
+	mt6323_update(c, MT6323_AUDTOP_CON1, 0x0700, c->mic_gain << 8);
+}
+
+/* TurnOnADcPowerACC(ADC1, main mic) and its disable path */
+static int mt6323_adc_event(struct snd_soc_dapm_widget *w,
+			    struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *cmp = snd_soc_dapm_to_component(w->dapm);
+	struct mt6323_codec *c = snd_soc_component_get_drvdata(cmp);
+	bool r48 = c->ul_rate == 48000;
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		mt6323_clk(c, true);
+		/* UL up8x_rxif, adc voice mode; NEWIF rate 1 (8/16/32k) or 3 (48k) */
+		mt6323_update(c, MT6323_AFE_PMIC_NEWIF_CFG2, 0xffff, 0x302f | (r48 ? 3 : 1) << 10);
+		mt6323_update(c, MT6323_ABB_AFE_CON1, 0x0010, r48 ? 0x0010 : 0);
+		mt6323_toggle(c, BIT(0), BIT(8));	/* TopCtlChangeTrigger */
+		mt6323_update(c, MT6323_ABB_AFE_CON0, BIT(1), BIT(1));	/* UL on */
+		mt6323_mic_gain_apply(c);
+		mt6323_update(c, MT6323_AUDTOP_CON0, 0x7f80, 0x7800);	/* LCH 1.4 V, 2.4 V */
+		mt6323_update(c, MT6323_AUDTOP_CON2, 0x00ff, 0x00f0);	/* RCH 1.4 V, 2.4 V */
+		mt6323_update(c, MT6323_AUDTOP_CON3, 0x0100, 0);
+		mt6323_update(c, MT6323_AUDTOP_CON0, 0x000f, 0);	/* PGA input: main mic */
+		/* ADC2 (right channel from the main mic as well) */
+		mt6323_update(c, MT6323_AUDTOP_CON3, 0x0200, 0x0200);
+		mt6323_update(c, MT6323_AUDTOP_CON1, 0x00f0, 0x0040);
+		mt6323_update(c, MT6323_AUDTOP_CON8, 0x0008, 0x0008);	/* MICBIAS */
+		mt6323_update(c, MT6323_AUDTOP_CON0, 0x0180, 0x0180);	/* LCH ADC + PGA */
+		mt6323_update(c, MT6323_AUDTOP_CON2, 0x0003, 0x0003);	/* RCH ADC + PGA */
+		c->ul_on = true;
+		break;
+	case SND_SOC_DAPM_POST_PMD:
+		mt6323_update(c, MT6323_AUDTOP_CON0, 0x0180, 0);
+		mt6323_update(c, MT6323_AUDTOP_CON2, 0x0003, 0);
+		mt6323_update(c, MT6323_AUDTOP_CON0, 0x7f80, c->dl_on ? 0x7000 : 0x6000);
+		mt6323_update(c, MT6323_AUDTOP_CON2, 0x00ff, 0x00c0);
+		mt6323_update(c, MT6323_AUDTOP_CON3, 0x0100, 0);
+		mt6323_update(c, MT6323_AUDTOP_CON0, 0x000f, 0x0003);
+		mt6323_update(c, MT6323_AUDTOP_CON3, 0x0200, 0);
+		mt6323_update(c, MT6323_AUDTOP_CON1, 0x00f0, 0x0020);
+		mt6323_update(c, MT6323_AUDTOP_CON8, 0x0008, 0);	/* MICBIAS off */
+		mt6323_update(c, MT6323_ABB_AFE_CON0, BIT(1), 0);	/* UL off */
+		c->ul_on = false;
+		mt6323_clk(c, false);
+		break;
+	}
+	return 0;
+}
+
+static void mt6323_hp_gain_apply(struct mt6323_codec *c)
+{
+	unsigned int att = 7 - min(c->hp_gain, 7u);
+
+	mt6323_update(c, MT6323_AUDTOP_CON5, 0x7700, att << 12 | att << 8);
+}
+
+/* Audio_Amp_Change (headphone buffers, which also drive the external speaker amp) */
+static int mt6323_hp_event(struct snd_soc_dapm_widget *w,
+			   struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *cmp = snd_soc_dapm_to_component(w->dapm);
+	struct mt6323_codec *c = snd_soc_component_get_drvdata(cmp);
+
+	switch (event) {
+	case SND_SOC_DAPM_POST_PMU:
+		/* No factory DC trim available yet: run with zero compensation. */
+		mt6323_update(c, MT6323_ABB_AFE_CON3, 0xffff, 0);
+		mt6323_update(c, MT6323_ABB_AFE_CON4, 0xffff, 0);
+		mt6323_update(c, MT6323_ABB_AFE_CON10, BIT(0), BIT(0));
+		mt6323_toggle(c, BIT(1), BIT(9));	/* DCChangeTrigger */
+		mt6323_update(c, MT6323_AUDTOP_CON6, 0xffff, 0xf7f2);
+		mt6323_update(c, MT6323_AUDTOP_CON0, 0xf000, 0x7000);
+		mt6323_update(c, MT6323_AUDTOP_CON5, 0xffff, 0x0014);
+		mt6323_update(c, MT6323_AUDTOP_CON4, 0xffff, 0x007c);
+		usleep_range(10000, 11000);
+		mt6323_update(c, MT6323_AUDTOP_CON6, 0xffff, 0xf5ba);
+		mt6323_update(c, MT6323_AUDTOP_CON5, 0xffff, 0x2214);
+		mt6323_hp_gain_apply(c);
+		break;
+	case SND_SOC_DAPM_PRE_PMD:
+		mt6323_update(c, MT6323_AUDTOP_CON5, 0xffff, 0x0014);
+		mt6323_update(c, MT6323_AUDTOP_CON6, 0xffff, 0xf7f2);
+		mt6323_update(c, MT6323_AUDTOP_CON4, 0xffff, 0x0000);
+		mt6323_update(c, MT6323_AUDTOP_CON0, 0x1000, 0x0000);
+		mt6323_update(c, MT6323_AUDTOP_CON6, 0xffff, 0x37e2);
+		break;
+	}
+	return 0;
+}
+
+static const DECLARE_TLV_DB_SCALE(hp_tlv, -500, 200, 0);
+
+static int mt6323_hp_vol_get(struct snd_kcontrol *kc, struct snd_ctl_elem_value *uc)
+{
+	struct snd_soc_component *cmp = snd_kcontrol_chip(kc);
+	struct mt6323_codec *c = snd_soc_component_get_drvdata(cmp);
+
+	uc->value.integer.value[0] = c->hp_gain;
+	return 0;
+}
+
+static int mt6323_hp_vol_put(struct snd_kcontrol *kc, struct snd_ctl_elem_value *uc)
+{
+	struct snd_soc_component *cmp = snd_kcontrol_chip(kc);
+	struct mt6323_codec *c = snd_soc_component_get_drvdata(cmp);
+	unsigned int v = uc->value.integer.value[0];
+	unsigned int con4 = 0;
+
+	if (v > 7)
+		return -EINVAL;
+	if (v == c->hp_gain)
+		return 0;
+	c->hp_gain = v;
+	regmap_read(c->regmap, MT6323_AUDTOP_CON4, &con4);
+	if (con4 & 0x7c)	/* only touch the gain while the buffers are on */
+		mt6323_hp_gain_apply(c);
+	return 1;
+}
+
+static const DECLARE_TLV_DB_SCALE(mic_tlv, -600, 600, 0);
+
+static int mt6323_mic_vol_get(struct snd_kcontrol *kc, struct snd_ctl_elem_value *uc)
+{
+	struct snd_soc_component *cmp = snd_kcontrol_chip(kc);
+	struct mt6323_codec *c = snd_soc_component_get_drvdata(cmp);
+
+	uc->value.integer.value[0] = c->mic_gain;
+	return 0;
+}
+
+static int mt6323_mic_vol_put(struct snd_kcontrol *kc, struct snd_ctl_elem_value *uc)
+{
+	struct snd_soc_component *cmp = snd_kcontrol_chip(kc);
+	struct mt6323_codec *c = snd_soc_component_get_drvdata(cmp);
+	unsigned int v = uc->value.integer.value[0];
+
+	if (v > 5)
+		return -EINVAL;
+	if (v == c->mic_gain)
+		return 0;
+	c->mic_gain = v;
+	if (c->ul_on)
+		mt6323_mic_gain_apply(c);
+	return 1;
+}
+
+static const struct snd_kcontrol_new mt6323_controls[] = {
+	SOC_SINGLE_EXT_TLV("Headphone Playback Volume", SND_SOC_NOPM, 0, 7, 0,
+			   mt6323_hp_vol_get, mt6323_hp_vol_put, hp_tlv),
+	SOC_SINGLE_EXT_TLV("Mic Capture Volume", SND_SOC_NOPM, 0, 5, 0,
+			   mt6323_mic_vol_get, mt6323_mic_vol_put, mic_tlv),
+};
+
+static const struct snd_soc_dapm_widget mt6323_widgets[] = {
+	SND_SOC_DAPM_AIF_IN("AIF RX", "AIF1 Playback", 0, SND_SOC_NOPM, 0, 0),
+	SND_SOC_DAPM_DAC_E("DAC", NULL, SND_SOC_NOPM, 0, 0, mt6323_dac_event,
+			   SND_SOC_DAPM_PRE_PMU | SND_SOC_DAPM_POST_PMD),
+	SND_SOC_DAPM_OUT_DRV_E("HP Buffer", SND_SOC_NOPM, 0, 0, NULL, 0,
+			       mt6323_hp_event,
+			       SND_SOC_DAPM_POST_PMU | SND_SOC_DAPM_PRE_PMD),
+	SND_SOC_DAPM_OUTPUT("HPL"),
+	SND_SOC_DAPM_OUTPUT("HPR"),
+	SND_SOC_DAPM_INPUT("MIC1"),
+	SND_SOC_DAPM_ADC_E("ADC", NULL, SND_SOC_NOPM, 0, 0, mt6323_adc_event,
+			   SND_SOC_DAPM_PRE_PMU | SND_SOC_DAPM_POST_PMD),
+	SND_SOC_DAPM_AIF_OUT("AIF TX", "AIF1 Capture", 0, SND_SOC_NOPM, 0, 0),
+};
+
+static const struct snd_soc_dapm_route mt6323_routes[] = {
+	{ "DAC", NULL, "AIF RX" },
+	{ "HP Buffer", NULL, "DAC" },
+	{ "HPL", NULL, "HP Buffer" },
+	{ "HPR", NULL, "HP Buffer" },
+	{ "ADC", NULL, "MIC1" },
+	{ "AIF TX", NULL, "ADC" },
+};
+
+static int mt6323_hw_params(struct snd_pcm_substream *substream,
+			    struct snd_pcm_hw_params *params,
+			    struct snd_soc_dai *dai)
+{
+	struct mt6323_codec *c = snd_soc_component_get_drvdata(dai->component);
+	unsigned int rate = params_rate(params);
+
+	if (substream->stream == SNDRV_PCM_STREAM_CAPTURE) {
+		if (rate != 8000 && rate != 16000 && rate != 32000 && rate != 48000)
+			return -EINVAL;
+		c->ul_rate = rate;
+		return 0;
+	}
+	if (mt6323_dl_rate(rate) < 0)
+		return -EINVAL;
+	c->rate = rate;
+	return 0;
+}
+
+static const struct snd_soc_dai_ops mt6323_dai_ops = {
+	.hw_params = mt6323_hw_params,
+};
+
+static struct snd_soc_dai_driver mt6323_dai = {
+	.name = "mt6323-codec-dai",
+	.playback = {
+		.stream_name = "AIF1 Playback",
+		.channels_min = 1,
+		.channels_max = 2,
+		.rates = SNDRV_PCM_RATE_8000_48000,
+		.formats = SNDRV_PCM_FMTBIT_S16_LE | SNDRV_PCM_FMTBIT_S24_LE |
+			   SNDRV_PCM_FMTBIT_S32_LE,
+	},
+	.capture = {
+		.stream_name = "AIF1 Capture",
+		.channels_min = 1,
+		.channels_max = 2,
+		.rates = SNDRV_PCM_RATE_8000 | SNDRV_PCM_RATE_16000 |
+			 SNDRV_PCM_RATE_32000 | SNDRV_PCM_RATE_48000,
+		.formats = SNDRV_PCM_FMTBIT_S16_LE | SNDRV_PCM_FMTBIT_S24_LE |
+			   SNDRV_PCM_FMTBIT_S32_LE,
+	},
+	.ops = &mt6323_dai_ops,
+};
+
+static int mt6323_component_probe(struct snd_soc_component *cmp)
+{
+	struct mt6323_codec *c = snd_soc_component_get_drvdata(cmp);
+
+	/* mt6323_codec_init_reg(): open UL PGA muxes, DAC bias 50%, HP depop mux on */
+	regmap_write(c->regmap, MT6323_TOP_CKPDN0_SET, CLKSQ_EN_AUD);
+	mt6323_update(c, MT6323_AUDTOP_CON0, 0x000f, 0x0002);
+	mt6323_update(c, MT6323_AUDTOP_CON1, 0x00f0, 0x0020);
+	mt6323_update(c, MT6323_AUDTOP_CON5, 0xffff, 0x1114);
+	mt6323_update(c, MT6323_AUDTOP_CON6, 0xffff, 0x37a2);
+	mt6323_update(c, MT6323_AUDTOP_CON6, 0xffff, 0x37e2);
+	regmap_write(c->regmap, MT6323_TOP_CKPDN0_CLR, CLKSQ_EN_AUD);
+	return 0;
+}
+
+static const struct snd_soc_component_driver mt6323_component = {
+	.name = "mt6323-codec",
+	.probe = mt6323_component_probe,
+	.controls = mt6323_controls,
+	.num_controls = ARRAY_SIZE(mt6323_controls),
+	.dapm_widgets = mt6323_widgets,
+	.num_dapm_widgets = ARRAY_SIZE(mt6323_widgets),
+	.dapm_routes = mt6323_routes,
+	.num_dapm_routes = ARRAY_SIZE(mt6323_routes),
+	.endianness = 1,
+};
+
+static int mt6323_codec_probe(struct platform_device *pdev)
+{
+	struct mt6397_chip *chip = dev_get_drvdata(pdev->dev.parent);
+	struct mt6323_codec *c;
+
+	c = devm_kzalloc(&pdev->dev, sizeof(*c), GFP_KERNEL);
+	if (!c)
+		return -ENOMEM;
+	c->dev = &pdev->dev;
+	c->regmap = chip->regmap;
+	c->rate = 48000;
+	c->hp_gain = 3;		/* +1 dB, vendor default index */
+	c->ul_rate = 48000;
+	c->mic_gain = 5;	/* +24 dB, as Fire OS uses for the built-in mic */
+	platform_set_drvdata(pdev, c);
+
+	return devm_snd_soc_register_component(&pdev->dev, &mt6323_component,
+					       &mt6323_dai, 1);
+}
+
+static const struct of_device_id mt6323_codec_of_match[] = {
+	{ .compatible = "mediatek,mt6323-codec" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt6323_codec_of_match);
+
+static struct platform_driver mt6323_codec_driver = {
+	.driver = {
+		.name = "mt6323-codec",
+		.of_match_table = mt6323_codec_of_match,
+	},
+	.probe = mt6323_codec_probe,
+};
+module_platform_driver(mt6323_codec_driver);
+
+MODULE_DESCRIPTION("MediaTek MT6323 PMIC audio codec");
+MODULE_LICENSE("GPL");
