// Fire HD 8 Linux: the person at the tablet (an active local session in the wheel group)
// may suspend, restart and power off without typing a password (needed for idle suspend
// and for "Restart now" after a system update).
// Installing and updating software without a password comes from Alpine's own Flatpak and
// apk-polkit rules, which also allow active local wheel users; see docs/UPDATES.md.
polkit.addRule(function(action, subject) {
    if (!subject.active || !subject.local || !subject.isInGroup("wheel"))
        return polkit.Result.NOT_HANDLED;
    if (action.id == "org.freedesktop.login1.suspend" ||
        action.id == "org.freedesktop.login1.suspend-multiple-sessions" ||
        action.id == "org.freedesktop.login1.reboot" ||
        action.id == "org.freedesktop.login1.power-off")
        return polkit.Result.YES;
    return polkit.Result.NOT_HANDLED;
});
