+// Hardware values are from this tablet's live stock tree and Goodix ID read.
+/dts-v1/;
+#include <dt-bindings/gpio/gpio.h>
+#include "mt8163-amazon-common.dtsi"
+#include "douglas-idme.dtsi"
+#include "douglas-power.dtsi"
+#include "douglas-smp.dtsi"
+#include "douglas-audio.dtsi"
+#include "douglas-wifi.dtsi"
+#include "douglas-sd-sensors.dtsi"
+#include "douglas-perf.dtsi"
+
+/ {
+    model = "Amazon Fire HD 8 (2017)";
+    compatible = "amazon,douglas", "mediatek,mt8163";
+    chassis-type = "tablet";
+    version = "hvt";
+
+    // CPUs: see douglas-smp.dtsi (stock vendor ATF PSCI 0.1 function IDs).
+
+    chosen {
+        #address-cells = <2>;
+        #size-cells = <2>;
+        ranges;
+        stdout-path = "serial0:921600n8";
+        bootargs = "console=tty0 loglevel=4 nokaslr clk_ignore_unused pd_ignore_unused regulator_ignore_unused rdinit=/init";
+        framebuffer@989e8000 {
+            compatible = "simple-framebuffer";
+            reg = <0 0x989e8000 0 0x3e8000>;
+            width = <800>;
+            height = <1280>;
+            stride = <3200>;
+            format = "a8b8g8r8";
+            backlight = <&disp_backlight>;
+            status = "okay";
+        };
+    };
+
+    memory {
+        // Exclude the vendor TEE region above 0x99600000.
+        reg = <0 0x40000000 0 0x59600000>;
+    };
+
+    reserved-memory {
+        // Retain the vendor firmware's log/crash areas, as in the stock tree.
+        ram_console@44400000 {
+            reg = <0 0x44400000 0 0x100000>;
+            no-map;
+        };
+        // Second half of the stock ram_console area: Linux pstore (crash logs survive WDT reset).
+        ramoops@44500000 {
+            compatible = "ramoops";
+            reg = <0 0x44500000 0 0x100000>;
+            record-size = <0x20000>;
+            console-size = <0x40000>;
+            pmsg-size = <0x20000>;
+            no-map;
+        };
+        lk_log@44600000 {
+            reg = <0 0x44600000 0 0x20000>;
+            no-map;
+        };
+        mdump@4bd00000 {
+            reg = <0 0x4bd00000 0 0x300000>;
+            no-map;
+        };
+        framebuffer_reserved: framebuffer@98600000 {
+            reg = <0 0x98600000 0 0x1000000>;
+            no-map;
+        };
+    };
+};
+
+// Mali-T720 for Panfrost. panfrost.ko is not installed at boot; it is loaded by hand
+// (or later by /etc/local.d) so a GPU power-up hang can never block booting.
+&gpu { status = "okay"; };
+// Preserve the stock LK scanout mapping until a native display driver is ready.
+&iommu { status = "disabled"; };
+// Stock lcd-backlight: led_mode 5 (CUST_BLS_PWM = display PWM), enable on GPIO43.
+// The LP8557 listed in the stock tree is not populated on this board (no ACK at 0x2c).
+// GPIO43 is held high by pinctrl only: switching it off for more than a few
+// seconds loses the LK-initialised panel state (picture never returns).
+&disp_backlight {
+    pinctrl-names = "default";
+    pinctrl-0 = <&douglas_backlight_pins>;
+    default-brightness-level = <600>;
+    status = "okay";
+};
+
+&i2c0 {
+    clock-frequency = <400000>;
+    pinctrl-names = "default";
+    pinctrl-0 = <&douglas_i2c0_pins>;
+    status = "okay";
+
+    touchscreen@5d {
+        compatible = "goodix,gt9110";
+        reg = <0x5d>;
+        pinctrl-names = "default";
+        pinctrl-0 = <&douglas_touch_pins>;
+        interrupt-parent = <&pio>;
+        // GPIO35 maps to EINT46 in the MT8163 pin controller.
+        interrupts = <46 IRQ_TYPE_EDGE_FALLING>;
+        irq-gpios = <&pio 35 GPIO_ACTIVE_HIGH>;
+        reset-gpios = <&pio 46 GPIO_ACTIVE_HIGH>;
+        AVDD28-supply = <&mt6323_vgp2_reg>;
+        touchscreen-size-x = <800>;
+        touchscreen-size-y = <1280>;
+    };
+};
+
+&mt6323_vgp2_reg {
+    regulator-min-microvolt = <2800000>;
+    regulator-max-microvolt = <2800000>;
+};
+&mt6323_vusb_reg { regulator-always-on; };
+&u2phy0 { status = "okay"; };
+&usb0 { dr_mode = "peripheral"; status = "okay"; };
+
+// Preserve the bootloader's eMMC pad configuration for initial low-speed access.
+&mmc0 {
+    bus-width = <8>;
+    non-removable;
+    no-sd;
+    no-sdio;
+    max-frequency = <200000000>;
+    douglas,keep-card-powered;
+    status = "okay";
+};
+
+&pio {
+    douglas_i2c0_pins: douglas-i2c0-pins {
+        pins {
+            pinmux = <MT8163_PIN_75_SDA0__FUNC_SDA0_0>,
+                     <MT8163_PIN_76_SCL0__FUNC_SCL0_0>;
+            bias-disable;
+        };
+    };
+    douglas_backlight_pins: douglas-backlight-pins {
+        pins-pwm {
+            pinmux = <MT8163_PIN_59_DISP_PWM__FUNC_DISP_PWM>;
+        };
+        pins-en {
+            pinmux = <MT8163_PIN_43_EINT11__FUNC_GPIO43>;
+            output-high;
+        };
+    };
+    douglas_touch_pins: douglas-touch-pins {
+        pins-irq {
+            pinmux = <MT8163_PIN_35_KPROW2__FUNC_GPIO35>;
+            bias-pull-up;
+            input-enable;
+        };
+        pins-reset {
+            pinmux = <MT8163_PIN_46_EINT14__FUNC_GPIO46>;
+            output-high;
+        };
+    };
+};
