+static int douglas_probe(struct platform_device *pdev)
+{
+	struct snd_soc_card *card = &douglas_card;
+	struct device_node *platform_node, *codec_node;
+	struct snd_soc_dai_link *link;
+	struct douglas_card *priv;
+	int i, ret;
+
+	priv = devm_kzalloc(&pdev->dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+	priv->spk_en = devm_gpiod_get(&pdev->dev, "speaker-amp", GPIOD_OUT_LOW);
+	if (IS_ERR(priv->spk_en))
+		return dev_err_probe(&pdev->dev, PTR_ERR(priv->spk_en), "speaker-amp gpio\n");
+	priv->hp_en = devm_gpiod_get(&pdev->dev, "headphone-amp", GPIOD_OUT_LOW);
+	if (IS_ERR(priv->hp_en))
+		return dev_err_probe(&pdev->dev, PTR_ERR(priv->hp_en), "headphone-amp gpio\n");
+
+	platform_node = of_parse_phandle(pdev->dev.of_node, "mediatek,platform", 0);
+	codec_node = of_parse_phandle(pdev->dev.of_node, "mediatek,audio-codec", 0);
+	if (!platform_node || !codec_node) {
+		ret = dev_err_probe(&pdev->dev, -EINVAL, "missing platform/codec phandle\n");
+		goto out;
+	}
+	for_each_card_prelinks(card, i, link) {
+		if (!link->platforms->name)
+			link->platforms->of_node = platform_node;
+		if (!link->codecs->name && !link->codecs->of_node && link->codecs->dai_name &&
+		    strcmp(link->codecs->dai_name, "snd-soc-dummy-dai"))
+			link->codecs->of_node = codec_node;
+	}
+	card->dev = &pdev->dev;
+	snd_soc_card_set_drvdata(card, priv);
+	ret = devm_snd_soc_register_card(&pdev->dev, card);
+	if (ret)
+		dev_err_probe(&pdev->dev, ret, "register card\n");
+out:
+	of_node_put(platform_node);
+	of_node_put(codec_node);
+	return ret;
+}
+
+static const struct of_device_id douglas_of_match[] = {
+	{ .compatible = "amazon,douglas-sound" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, douglas_of_match);
+
+static struct platform_driver douglas_driver = {
+	.driver = {
+		.name = "mt8163-douglas",
+		.of_match_table = douglas_of_match,
+	},
+	.probe = douglas_probe,
+};
+module_platform_driver(douglas_driver);
+
+MODULE_DESCRIPTION("Amazon Fire HD 8 (douglas) sound card");
+MODULE_LICENSE("GPL");
