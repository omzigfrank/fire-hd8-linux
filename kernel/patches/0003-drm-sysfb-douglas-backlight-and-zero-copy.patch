+/* douglas: MT8163 DISP_OVL0 layer 3 registers */
+#define DOUGLAS_OVL_L3_CON	0x090
+#define DOUGLAS_OVL_L3_PITCH	0x0a4
+#define DOUGLAS_OVL_L3_ADDR	0x0fa0
+#define DOUGLAS_OVL_CON_AEN	BIT(8)
+#define DOUGLAS_OVL_CON_FMT_MASK	(GENMASK(15, 12) | BIT(24) | BIT(25))
+#define DOUGLAS_OVL_CON_RGBA8888	(2 << 12)
+#define DOUGLAS_OVL_CON_BYTE_SWAP	BIT(24)
+
+static void douglas_zc_restore(struct drm_sysfb_device *sysfb)
+{
+	if (!sysfb->douglas_zc_active)
+		return;
+	writel(sysfb->douglas_fb_phys, sysfb->douglas_ovl + DOUGLAS_OVL_L3_ADDR);
+	writel(sysfb->douglas_pitch, sysfb->douglas_ovl + DOUGLAS_OVL_L3_PITCH);
+	writel(sysfb->douglas_con, sysfb->douglas_ovl + DOUGLAS_OVL_L3_CON);
+	sysfb->douglas_zc_active = false;
+}
+
+/* Point the overlay at the framebuffer itself. Returns false to fall back to copying. */
+static bool douglas_zc_try(struct drm_sysfb_device *sysfb, struct drm_plane_state *ps)
+{
+	struct drm_framebuffer *fb = ps->fb;
+	struct drm_gem_dma_object *dma;
+	dma_addr_t addr;
+	u32 fmt;
+
+	if (!sysfb->douglas_ovl || !fb || !fb->obj[0] || !ps->visible)
+		return false;
+	switch (fb->format->format) {
+	case DRM_FORMAT_XBGR8888:
+	case DRM_FORMAT_ABGR8888:
+		fmt = DOUGLAS_OVL_CON_RGBA8888 | DOUGLAS_OVL_CON_BYTE_SWAP;
+		break;
+	case DRM_FORMAT_XRGB8888:
+	case DRM_FORMAT_ARGB8888:
+		fmt = DOUGLAS_OVL_CON_RGBA8888;
+		break;
+	default:
+		return false;
+	}
+	if (ps->src_x || ps->src_y || ps->crtc_x || ps->crtc_y ||
+	    (ps->src_w >> 16) != sysfb->fb_mode.hdisplay ||
+	    (ps->src_h >> 16) != sysfb->fb_mode.vdisplay || fb->pitches[0] > 0xffff)
+		return false;
+	dma = to_drm_gem_dma_obj(fb->obj[0]);
+	addr = dma->dma_addr + fb->offsets[0];
+	if (!dma->dma_addr || upper_32_bits(addr) || (addr & 0xf))
+		return false;
+
+	writel(lower_32_bits(addr), sysfb->douglas_ovl + DOUGLAS_OVL_L3_ADDR);
+	writel((sysfb->douglas_pitch & 0xffff0000) | fb->pitches[0],
+	       sysfb->douglas_ovl + DOUGLAS_OVL_L3_PITCH);
+	/* X/alpha byte is not meaningful: scan out opaque */
+	writel((sysfb->douglas_con & ~(DOUGLAS_OVL_CON_AEN | DOUGLAS_OVL_CON_FMT_MASK | 0xff)) |
+	       fmt | 0xff,
+	       sysfb->douglas_ovl + DOUGLAS_OVL_L3_CON);
+	sysfb->douglas_zc_active = true;
+	return true;
+}
