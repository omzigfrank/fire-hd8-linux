+struct mtk_base_afe;
+
+int mt8163_init_clock(struct mtk_base_afe *afe);
+int mt8163_afe_enable_clock(struct mtk_base_afe *afe);
+void mt8163_afe_disable_clock(struct mtk_base_afe *afe);
