+
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/phy/phy.h>
+#include <dt-bindings/thermal/thermal.h>
+
+#include <dt-bindings/clock/mediatek,mt8163-audsys.h>
+#include <dt-bindings/clock/mediatek,mt8163-apmixedsys.h>
+#include <dt-bindings/clock/mediatek,mt8163-imgsys.h>
+#include <dt-bindings/clock/mediatek,mt8163-infracfg.h>
+#include <dt-bindings/clock/mediatek,mt8163-mfgcfg.h>
+#include <dt-bindings/clock/mediatek,mt8163-mmsys.h>
+#include <dt-bindings/clock/mediatek,mt8163-topckgen.h>
+#include <dt-bindings/clock/mediatek,mt8163-vdecsys.h>
+#include <dt-bindings/clock/mediatek,mt8163-vencsys.h>
+#include <dt-bindings/gce/mediatek,mt8163-gce.h>
